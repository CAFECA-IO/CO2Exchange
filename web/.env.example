# 鏈
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
# 部署檔（預設 ../deployments/<CHAIN_ID>.json）
# DEPLOYMENT_FILE=

# Phase 0：relayer / 身分驗證服務 同一把（Anvil account0）。正式環境分開並放 HSM。
RELAYER_PK=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
IDENTITY_VERIFIER_PK=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
IDENTITY_SALT=change-me

# Auth.js
AUTH_SECRET=please-generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000
# 設定後才會出現 Google / Apple 登入按鈕
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_APPLE_ID=
# AUTH_APPLE_SECRET=
# 正式環境要顯示開發用登入時設 1（預設只在 development 出現）
# AUTH_DEV_LOGIN=1

# 角色（Phase 0 以 email 允許清單判定）
ADMIN_EMAILS=admin@example.com
VERIFIER_EMAILS=verifier@example.com
# 查驗機構簽章金鑰（Phase 0 放本站；正式由查驗機構自行簽）與憑證文件回寫金鑰（DOCUMENT_ROLE）
CARBON_VERIFIER_PK=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
DOCUMENT_SIGNER_PK=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# KYC：1 = 送出即核准（demo）；0 = 進管理後台審核佇列
KYC_AUTO_APPROVE=0
# 憑證 PDF 字型（預設 fonts/NotoSansTC-Subset.otf）
# CERT_FONT_PATH=

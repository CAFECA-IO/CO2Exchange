# ── 鏈 ────────────────────────────────────────────────────────────
#
# 本機（預設）：
RPC_URL=http://127.0.0.1:28545
CHAIN_ID=31337
#
# Boltchain 測試網（CAFECA 身分合約所在的鏈，chainId 8018）：
#   RPC_URL=http://211.22.118.149:8545      ← 節點在這裡，不是 boltchain.cafeca.io
#   CHAIN_ID=8018
#   ⚠️ boltchain.cafeca.io 上跑的是 Explorer，POST JSON-RPC 不通；
#      /.well-known/cafeca-configuration 的 chain.rpc 指向它，是設定檔的問題。
#   ⚠️ 純 HTTP，沒有 TLS。RPC 流量是明文的——測試網可以，正式環境不行。
#      瀏覽器碰不到它（HTTPS 頁面不能呼叫 http://），而本專案的鏈上讀寫
#      本來就全在伺服器端，所以不受影響。
#   實測 2026-09-28：boltchain/v0.1.0、Cancun 齊備（TSTORE / MCOPY / PUSH0）、
#      EIP-1559、6 秒出塊、gasLimit 30,000,000。
#   身分與資產**要在同一條鏈**，否則爭議時沒辦法在鏈上驗簽章
#   （合約發不出跨鏈的 eth_call），逃生門與委託單爭議都會退化成只能鏈下處理。
#
# 公開測試鏈 Base Sepolia：
#   RPC_URL=https://sepolia.base.org      ← 自己的供應商端點更好，公共端點有速率限制
#   CHAIN_ID=84532
#
# 結算幣：部署時用 SETTLEMENT_TOKEN 指定外部代幣就不會發 MockTWD。
#   Boltchain 上是 CAFECA 的 TWDC 0xb07f90B82eEb0269fAcafC5A6a6CC01BE4747bA3
#   （6 decimals，與 MockTWD 相同，價格不必換算）。
#   用外部結算幣時本站沒有鑄幣權，demo faucet 不會運作——這是對的：
#   一個能憑空生出結算幣的交易所，它的資產池揭露就沒有意義了。
#
# 部署檔（預設 ../deployments/<CHAIN_ID>.json，由部署腳本自己寫）
# DEPLOYMENT_FILE=
#
# 交易等待：確認數與逾時。公開鏈的預設是 1 個確認、120 秒；本機是 1 個、30 秒。
# TX_CONFIRMATIONS=1
# TX_TIMEOUT_MS=120000

# ── 服務金鑰 ──────────────────────────────────────────────────────
#
# ⚠️ 下面這些預設值是 **Anvil 的公開金鑰**（印在 anvil 的啟動畫面上，全世界都有）。
#    它們只在 chainId 31337 / 1337 可以用。任何其他鏈上，程式會在啟動時直接拒絕——
#    不是保護潔癖：這一把金鑰在本系統裡同時能凍結任何人的錢包、替任何人簽發身分、
#    核發碳權額度。在公開鏈上沿用它，等於把這三件事開放給所有人。
#
#    換到公開鏈時：每一把都換成這條鏈專用的新金鑰（`cast wallet new`），
#    並且 RELAYER_PK 那把要有餘額——平台代付所有使用者的 gas。
#    餘額見底時所有交易都會失敗，錯誤碼是 RELAYER_UNFUNDED。
#
RELAYER_PK=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
IDENTITY_VERIFIER_PK=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# 身分雜湊的鹽。**公開鏈上一定要換掉**：鏈上存的是 keccak(idNumber + salt)，
# 鹽如果是這份範例裡的字串，任何人都能把身分證號逐一試出來（號碼空間只有幾億）。
IDENTITY_SALT=change-me

# Auth.js
# AUTH_SECRET 同時是 CAFECA 登入 nonce 的 HMAC 金鑰。production 沒設會直接起不來——
# 沒有它，nonce 是任何人都算得出來的值，重送保護等於不存在。
AUTH_SECRET=please-generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:10010

# ── 以 CAFECA 登入 ────────────────────────────────────────────────
#
# 登入 = 證明你控制一個 CAFECA 身分合約。那個合約地址就是使用者在本站的唯一 ID。
#
# SITE_ORIGIN 是**防仿冒的全部**：錢包簽下的訊息帶著要登入的網域，後端逐字比對。
# 它必須與瀏覽器網址列完全相同（含 scheme 與 port）。沒設就退回 AUTH_URL。
# 比對逐字進行，不做 endsWith 或只比主機名——那樣 shop.example.attacker.com 會過關。
SITE_ORIGIN=http://localhost:10010
# 錢包網域。決定使用者在哪裡看到確認畫面，也決定我們去問哪一個合約「這個簽章有效嗎」，
# 所以它只來自環境變數，永遠不從請求內容取得。
CAFECA_WALLET=https://cafeca.io
NEXT_PUBLIC_CAFECA_WALLET=https://cafeca.io
# 以下留空就在啟動時讀 <CAFECA_WALLET>/.well-known/cafeca-configuration。
# 設了就完全不碰網路——正式環境建議這樣做：登入能不能用，不該取決於
# 另一個網域此刻醒著沒有。
# **目前必須設**：那份設定檔的 chain.rpc 指向 Explorer（不服務 JSON-RPC），
# 而且 issuer 還是 http://localhost:10002（開發版錢包沒設 PUBLIC_ORIGIN）。
# CAFECA_CHAIN_ID=8018
# CAFECA_RPC_URL=http://211.22.118.149:8545
# CAFECA_ATTESTATION=0x4b08B5063eE773C084dD9E67E09690aF8cb2A880
# CAFECA_RECOVERY=0xA199a3f7afd81bDBC6CE697400Fa44d5b6a16594
# CAFECA_FACTORY=0x075e377D1096089aE2D44fbD23156BF900b8bd24
# CAFECA_KEYRING=0x367a9E8a6E8bA108F4cC4B863d03dD618aD7893b

# 角色（Phase 0 以**地址**允許清單判定——身分已經是地址，不再有 email）
# ⚠️ 這兩行要包含「你自己登入後拿到的地址」，否則 /admin 與 /verifier 都進不去。
#    搭配 KYC_AUTO_APPROVE=0 時最容易踩到：申請會送進審核佇列，但沒有任何帳號能核准它。
#    開發用登入的地址是從代號推出來的，登入一次就看得到。
#    非 production 留空時，預設是開發用登入 admin@example.com / verifier@example.com
#    推出來的那兩個地址（見 lib/server/roles.ts），本機與 e2e 因此零設定就能用。
ADMIN_ADDRESSES=
VERIFIER_ADDRESSES=
# 查驗機構簽章金鑰（Phase 0 放本站；正式由查驗機構自行簽）與憑證文件回寫金鑰（DOCUMENT_ROLE）
CARBON_VERIFIER_PK=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
DOCUMENT_SIGNER_PK=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# KYC：1 = 送出即核准（快速跑通流程）；0 = 進管理後台審核佇列（展示人工審核，需要 ADMIN_ADDRESSES 包含你自己）
KYC_AUTO_APPROVE=0
# 行情圖上的碳費參考線 / 統計（每噸，結算幣最小單位；300 元/噸 = 300000000）。
# 留空就不顯示——請填主管機關實際公告的費率，不要用估的。
# CARBON_FEE_PER_TONNE=

# 憑證 PDF 字型（預設 fonts/NotoSansTC-Subset.otf）
# CERT_FONT_PATH=

# ── 費思（站內 AI 助理）────────────────────────────────────────────
# 沒設這一段，費思會顯示「未啟用」並退場；本站其餘功能完全不受影響。
#
# 兩種端點，看你要接哪一個：
#   · Anthropic Messages API → 只設 FAITH_API_KEY
#   · OpenAI 相容 chat/completions（含多數自架閘道器）→ 再設 FAITH_BASE_URL
# FAITH_API_KEY=
# FAITH_BASE_URL=https://your-gateway.example.com/v1
# FAITH_MODEL=claude-sonnet-4-5
# 模型端逾時（毫秒）與每人每分鐘的問題數上限
# FAITH_TIMEOUT_MS=60000
# FAITH_RATE_PER_MIN=12
#
# ⚠️ 開了費思，使用者的提問與工具查到的資料（含他自己的持倉與身分等級）
#    會送到你設定的那個模型端點。那是一次**境外/第三方傳輸**，
#    隱私權政策第八條已經據此寫好——換端點時記得一併更新該條的敘述。

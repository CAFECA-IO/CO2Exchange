# ── 鏈 ────────────────────────────────────────────────────────────
#
# 本機（預設）：
RPC_URL=http://127.0.0.1:28545
CHAIN_ID=31337
#
# 公開測試鏈 Base Sepolia：
#   RPC_URL=https://sepolia.base.org      ← 自己的供應商端點更好，公共端點有速率限制
#   CHAIN_ID=84532
#
# 部署檔（預設 ../deployments/<CHAIN_ID>.json，由部署腳本自己寫）
# DEPLOYMENT_FILE=
#
# 交易等待：確認數與逾時。公開鏈的預設是 1 個確認、120 秒；本機是 1 個、30 秒。
# TX_CONFIRMATIONS=1
# TX_TIMEOUT_MS=120000

# ── 服務金鑰 ──────────────────────────────────────────────────────
#
# ⚠️ 下面這些預設值是 **Anvil 的公開金鑰**（印在 anvil 的啟動畫面上，全世界都有）。
#    它們只在 chainId 31337 / 1337 可以用。任何其他鏈上，程式會在啟動時直接拒絕——
#    不是保護潔癖：這一把金鑰在本系統裡同時能凍結任何人的錢包、替任何人簽發身分、
#    核發碳權額度。在公開鏈上沿用它，等於把這三件事開放給所有人。
#
#    換到公開鏈時：每一把都換成這條鏈專用的新金鑰（`cast wallet new`），
#    並且 RELAYER_PK 那把要有餘額——平台代付所有使用者的 gas。
#    餘額見底時所有交易都會失敗，錯誤碼是 RELAYER_UNFUNDED。
#
RELAYER_PK=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
IDENTITY_VERIFIER_PK=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# 身分雜湊的鹽。**公開鏈上一定要換掉**：鏈上存的是 keccak(idNumber + salt)，
# 鹽如果是這份範例裡的字串，任何人都能把身分證號逐一試出來（號碼空間只有幾億）。
IDENTITY_SALT=change-me

# Auth.js
AUTH_SECRET=please-generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:10010
# 設定後才會出現 Google / Apple 登入按鈕
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_APPLE_ID=
# AUTH_APPLE_SECRET=
# 正式環境要顯示開發用登入時設 1（預設只在 development 出現）
# AUTH_DEV_LOGIN=1

# 角色（Phase 0 以 email 允許清單判定）
# ⚠️ 這兩行要包含「你自己登入用的 email」，否則 /admin 與 /verifier 都進不去。
#    搭配 KYC_AUTO_APPROVE=0 時最容易踩到：申請會送進審核佇列，但沒有任何帳號能核准它。
ADMIN_EMAILS=admin@example.com
VERIFIER_EMAILS=verifier@example.com
# 查驗機構簽章金鑰（Phase 0 放本站；正式由查驗機構自行簽）與憑證文件回寫金鑰（DOCUMENT_ROLE）
CARBON_VERIFIER_PK=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
DOCUMENT_SIGNER_PK=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# KYC：1 = 送出即核准（快速跑通流程）；0 = 進管理後台審核佇列（展示人工審核，需要 ADMIN_EMAILS 包含你自己）
KYC_AUTO_APPROVE=0
# 行情圖上的碳費參考線 / 統計（每噸，結算幣最小單位；300 元/噸 = 300000000）。
# 留空就不顯示——請填主管機關實際公告的費率，不要用估的。
# CARBON_FEE_PER_TONNE=

# 憑證 PDF 字型（預設 fonts/NotoSansTC-Subset.otf）
# CERT_FONT_PATH=

# ── 費思（站內 AI 助理）────────────────────────────────────────────
# 沒設這一段，費思會顯示「未啟用」並退場；本站其餘功能完全不受影響。
#
# 兩種端點，看你要接哪一個：
#   · Anthropic Messages API → 只設 FAITH_API_KEY
#   · OpenAI 相容 chat/completions（含多數自架閘道器）→ 再設 FAITH_BASE_URL
# FAITH_API_KEY=
# FAITH_BASE_URL=https://your-gateway.example.com/v1
# FAITH_MODEL=claude-sonnet-4-5
# 模型端逾時（毫秒）與每人每分鐘的問題數上限
# FAITH_TIMEOUT_MS=60000
# FAITH_RATE_PER_MIN=12
#
# ⚠️ 開了費思，使用者的提問與工具查到的資料（含他自己的持倉與身分等級）
#    會送到你設定的那個模型端點。那是一次**境外/第三方傳輸**，
#    隱私權政策第八條已經據此寫好——換端點時記得一併更新該條的敘述。

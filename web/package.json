{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p ${PORT:-10010}",
    "deploy": "bash ../script/bootstrap.sh chain",
    "prebuild": "node scripts/clean-dev-types.mjs",
    "build": "next build",
    "start": "next start -p ${PORT:-10010}",
    "lint": "eslint",
    "check:boundary": "node scripts/check-client-boundary.mjs",
    "check:api-envelope": "node scripts/check-api-envelope.mjs",
    "e2e": "npm run check:boundary && npm run check:api-envelope && node e2e/globe.mjs && node e2e/resilience.mjs && node e2e/faith.mjs",
    "data:reset": "node scripts/data-reset.mjs",
    "gen:errors": "node scripts/gen-error-abi.mjs",
    "gen:tree-fixture": "node --experimental-strip-types --no-warnings scripts/gen-tree-fixture.mjs",
    "test:keys": "node scripts/test-keys.mjs",
    "test:mm": "node scripts/test-mm.mjs",
    "gen:ledger-fixture": "node --experimental-strip-types --no-warnings scripts/gen-ledger-fixture.mjs",
    "test:ledger": "node --experimental-strip-types --no-warnings scripts/test-ledger.mjs",
    "test:ledger-chain": "node --experimental-strip-types --no-warnings scripts/e2e-ledger-chain.mjs",
    "test:ledger-write": "node --experimental-strip-types --no-warnings scripts/e2e-ledger-write.mjs",
    "kyc:sync": "node --experimental-strip-types --no-warnings scripts/kyc-sync.mjs",
    "ledger:health": "node --experimental-strip-types --no-warnings scripts/ledger-health.mjs",
    "ledger:seed": "node --experimental-strip-types --no-warnings scripts/ledger-seed.mjs",
    "ledger:commit": "node --experimental-strip-types --no-warnings scripts/ledger-commit.mjs",
    "ledger:verify": "node --experimental-strip-types --no-warnings scripts/ledger-commit.mjs --verify",
    "ledger:authority": "node --experimental-strip-types --no-warnings scripts/ledger-authority.mjs",
    "data:protect": "node --experimental-strip-types --no-warnings scripts/data-protect.mjs",
    "test:sealed": "node --experimental-strip-types --no-warnings scripts/test-sealed.mjs",
    "fiat": "node --experimental-strip-types --no-warnings scripts/fiat.mjs",
    "mm": "node --experimental-strip-types --no-warnings scripts/mm/mm.mjs",
    "test:cafeca": "node --conditions=react-server --experimental-strip-types --no-warnings scripts/test-cafeca.mjs",
    "ledger:sim": "node --experimental-strip-types --no-warnings scripts/ledger-sim.mjs",
    "test:ledger-mm": "node --experimental-strip-types --no-warnings scripts/e2e-ledger-mm.mjs",
    "ledger:publish": "node --experimental-strip-types --no-warnings scripts/ledger-publish.mjs",
    "verify:proof": "node scripts/verify-proof.mjs",
    "test:ledger-kyc": "node --experimental-strip-types --no-warnings scripts/e2e-ledger-kyc.mjs",
    "test:ledger-proof": "node --experimental-strip-types --no-warnings scripts/e2e-ledger-proof.mjs"
  },
  "dependencies": {
    "@noble/curves": "^1.9.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "next": "16.3.5",
    "next-auth": "^5.0.0-beta.32",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "viem": "^2.56.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "playwright": "^1.63.0",
    "server-only": "^0.0.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
